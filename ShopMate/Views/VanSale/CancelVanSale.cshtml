@model ShopMate.ModelDto.VanSaleDto

@{
    /**/

    ViewBag.Title = "Details";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}
<section class="content-header">
    <h1>
        @ViewBag.Title
        <small>Details</small>
    </h1>
</section>
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">

            <div class="box box-solid box-primary">
                <div class="box-header">
                    <h3 class="box-title">Detail of Vansale</h3>
                </div><!-- /.box-header -->
                <div class="box-body table-responsive">

                    <div class="widget-sec">
                        <div class="streaming-table">
                            <table class="table table-striped table-bordered">

                                <tr>
                                    <td>Van Sale Id</td>
                                    <td>@Html.DisplayFor(model => model.Id)</td>
                                </tr>
                                <tr>
                                    <td>Van</td>
                                    <td>@Html.DisplayFor(model => model.Van)</td>
                                </tr>
                                <tr>
                                    <td>Driver</td>
                                    <td>@Html.DisplayFor(model => model.Driver)</td>
                                </tr>
                                <tr>
                                    <td>Stock Value</td>
                                    <td>@Html.DisplayFor(model => model.StockValue)</td>
                                </tr>
                                <tr>
                                    <td>Date Added</td>
                                    <td>@Html.DisplayFor(model => model.DateAdded)</td>
                                </tr>
                                <tr>
                                    <td>Warehouse</td>
                                    <td>@Html.DisplayFor(model => model.Warehouse)</td>
                                </tr>


                            </table>
                            <div class="col-xs-11" style="margin-left:0%;">
                                <table class="table table-striped table-bordered">
                                    @*<table class="table" style="font-size: 1.8vmin; width: 98%;height: auto;font-weight: 200;margin-right:2%; position: relative;">*@
                                    <thead style="background-color:#e5e2e2;">
                                        <tr>
                                            <th>Product</th>
                                            <th>OpeningStock</th>
                                            <th>ClosingStock</th>
                                            <th>GoodsSold</th>
                                            <th>SellingPrice</th>
                                            <th>Sales</th>
                                            <th>CostPrice</th>
                                            <th>G.P</th>
                                            <th>Profit</th>
                                            <th>StockValue</th>
                                            <th>Truck</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.items)
                                        {
                                        <tr>
                                            <td>@item.Product</td>
                                            <td>@item.OpeningStock</td>
                                            <td>@item.ClosingStock</td>
                                            <td>@item.GoodsSold</td>
                                            <td>@item.SalePrice</td>
                                            <td>@item.Sales</td>
                                            <td>@item.UnitPrice</td>
                                            <td>@item.GP</td>
                                            <td>@item.GP</td>
                                            <td>@item.StockValue</td>
                                            <td>@item.VanSaleId</td>
                                            @*<td></td>*@
                                        </tr>
                                        }

                                    </tbody>
                                </table>
                            </div>
                            @*<div class="box-footer">*@
                                @* @Ajax.ModalDialogActionLink("Cancel Van Sale", "Delete/" + Model.Id, "Delete", "btn btn-primary")*@
                                @*<button id="Deletebtn" type="submit" class="btn btn-primary">Cancel Van Sale</button>*@
                                @*<input type="submit" id="Ref" value="Cancel Van Sale" class="btn btn-primary">*@
                        <div class="box-footer">

                            @*@using (Html.BeginForm("DeleteConfirmed/" + Model.Id, "VanSale", FormMethod.Post, new { id = "frmVanSale" }))
        {
            @Html.AntiForgeryToken()

            @Html.StarkInputButtion("Van Sale Cancel", "submit", "btn btn-danger","")
            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-primary" })

            //buttons += '<li><a href="' + ControlerNamePurchase + "/Delete/" + row[0] + '" data-ajax-update="#SkDelete" data-ajax-success="openModalDialog(\'SkDelete\', \'Delete\')" data-ajax-mode="replace" data-ajax-method="GET" data-ajax-failure="clearModalDialog(\'SkDelete\');alert(\'Ajax call failed\')" data-ajax-begin="prepareModalDialog(\'SkDelete\')" data-ajax="true"><i class="fa fa-trash-o"></i> Delete</a></a></li>';
        }*@
                            @using (Html.BeginForm("Delete/" + Model.Id, "VanSale", FormMethod.Post, new { id = "frmOrder" }))
                            {
                                @Html.AntiForgeryToken()

                                @Html.StarkInputButtion("Van Sale Cancel", "submit", "btn btn-danger", "")
                                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-primary" })
                            }


                        </div>
                                @*@Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-primary" })*@
                            @*</div>*@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    $(document).ready(function () {

        $("#Dispatch").click(function (e) {
            var Id = $("#idyangu").Name;
            console.log( "Id is: " + Id);
            $.ajax({
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                type: 'POST',
                url: "/Order/Dispatch" + Id,
                data: "",
                success: function (result) {
                    alert("Saved");
                    location.reload();
                },
                error: function (xhr, status, error) {
                    var errorMessage = xhr.status + ': ' + xhr.statusText
                    alert('Error - ' + errorMessage);
                }
            });


        });
    });
     $(function updatep() {

        $("#Deletebtn").click(function () {


            var catId = 1;
            $.ajax({
                type: "POST",
                //url: "~/UpdatePrice?Id=" + catId + "&addprice=" + pernt + "",
                url: "@Url.Action("Delete", "VanSale")?Id=" + catId +,

                datatype: "json",
                data: "",
                success: function () {

                    //$("#upbtn").closest("tr").find("td:eq(4)").text(400);
                    //$('#progressmodal').modal('hide');

                    loadProducts();
                },
                error: function (req, textStatus, errorThrown) {
                    //this is going to happen when you send something different from a 200 OK HTTP
                    alert('Ooops, something happened: ' + textStatus + ' ' + errorThrown);
                }

            });


        });
    });
</script>

