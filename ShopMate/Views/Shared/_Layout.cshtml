<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - ZiPOS</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/Content/theme/plugins/datepicker/datepicker3.css" rel="stylesheet" />
    <link href="~/Content/tabs/JqueryUi.css" rel="stylesheet" />
    <link href="~/Content/notifire/noti.css" rel="stylesheet" />
    <link href="~/Content/NiceDropdown/searchableOptionList.css" rel="stylesheet" />
    <link href="~/Content/NiceDropdown/sol.css" rel="stylesheet" />
    <link href="~/Content/ModelPopup/base/jquery.ui.all.css" rel="stylesheet" />
    <link href="~/Content/shopmate-saas.css" rel="stylesheet" />

    @if (ViewBag.MenuOpen == "Reports")
    {
        @Html.Partial("_ReportAssets")
    }

    <script src="~/Content/theme/plugins/jQuery/jQuery-2.1.3.min.js"></script>
    <script src="~/Scripts/jquery-ui.min.js"></script>
    <script src="~/Content/notifire/notij.js"></script>
    <script>
        $(document).ready(function () {
            @{
                if (TempData["success"] != null)
                {
                    @:$.sticky("<br/> @TempData["success"]", { stickyClass: 'success' });
                }
            }
        });

        jQuery.ajaxSetup({
            beforeSend: function () { $('#starkloader').show(); },
            complete: function () { $('#starkloader').hide(); },
            success: function () { }
        });
    </script>
    <script src="~/Content/NiceDropdown/sol.js"></script>
    @RenderSection("ScriptsOrCss", required: false)
    @{ TempData["ThisUrl"] = Request.Url.ToString(); }
</head>
@{
    var userName = Env.GetUserInfo("name") ?? "User";
    var userInitial = string.IsNullOrWhiteSpace(userName) ? "U" : userName.Substring(0, 1).ToUpper();
}
<body class="app-body">
    <div id="starkloader" class="starkloader" aria-hidden="true"></div>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <div class="app-shell">
        <aside class="app-sidebar" id="appSidebar">
            <div class="app-sidebar-header">
                <a href="@Url.Content("~/Home")" class="app-brand">
                    <span class="app-brand-mark"><i class="bi bi-shop"></i></span>
                    <span>ZiPOS</span>
                </a>
            </div>

            <div class="sidebar-user-card">
                <div class="sidebar-user-avatar">@userInitial</div>
                <div class="sidebar-user-meta">
                    <div class="sidebar-user-name">@userName</div>
                    <div class="sidebar-user-status"><i class="fa fa-circle" style="font-size:0.55rem;"></i> Online</div>
                </div>
            </div>

            <nav class="app-sidebar-nav">
                @Env.GetMenuBarPage(null, ViewBag.MenuOpen)
            </nav>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <button type="button" class="sidebar-toggle-btn d-lg-none" id="sidebarToggle" aria-label="Toggle navigation">
                    <i class="bi bi-list"></i>
                </button>

                <div class="topbar-expiry d-none d-md-block">
                    <b>@Env.GetUserExpiry()</b>
                </div>

                <div class="topbar-actions">
                    <div class="dropdown">
                        <a href="#" class="topbar-user-btn dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="sidebar-user-avatar" style="width:28px;height:28px;font-size:0.75rem;">@userInitial</span>
                            <span class="d-none d-sm-inline">@userName</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0" style="border-radius:10px;padding:0.4rem;">
                            <li><a class="dropdown-item rounded-2" href="~/User/UserProfile"><i class="bi bi-person me-2"></i>Profile</a></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li><a class="dropdown-item rounded-2 text-danger" href="~/Account/signout"><i class="bi bi-box-arrow-right me-2"></i>Sign out</a></li>
                        </ul>
                    </div>
                </div>
            </header>

            <main class="page-wrapper">
                @RenderBody()
            </main>

            <footer class="site-footer">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span><strong>Copyright &copy; @DateTime.Now.Year <a href="https://www.zimhope.co.zw">Zimhope</a>.</strong> All rights reserved.</span>
                    <span class="text-muted">Version 4.22.10</span>
                </div>
            </footer>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/theme/plugins/datepicker/bootstrap-datepicker.js"></script>
    <script src="~/Content/ModelPopup/jquery.unobtrusive-ajax.js"></script>
    <script src="~/Content/ModelPopup/modaldialog.js"></script>
    <script src="~/Content/shopmate-site.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
