@model ShopMate.Models.GRV

@{
    ViewBag.Title = "Create";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

<script src="~/Content/ckeditor/ckeditor.js"></script>

@Html.StarkAjaxFormSubmiter("frmGRV", "tbGRV", true, "Action Successfully Executed")

@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
            <h1>
                @ViewBag.Title
                <small>@ViewBag.Title</small>
            </h1>
        </section>
    }
}
<script type="text/javascript">
    $(function () {
        $('select').searchableOptionList({
            maxHeight: '250px'
        });
    });
</script>
@using (Html.BeginForm("Create", "GRV", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmGRV" }))
{
    @Html.AntiForgeryToken()
    <!-- Main content -->
    <section class="content">
        <!-- Small boxes (Stat box) -->
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-solid box-primary">
                    <div class="box-header">
                        <h3 class="box-title">Fill Stock Transfer Form</h3>
                    </div><!-- /.box-header -->
                    <!-- form start -->
                    <div role="form">
                        <div class="box-body">
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.DropDownList("WarehouseId", null, "- Select Warehouse -", new { @id = "warehouse" })@*<br />*@
                                        @*@Html.StarkDropDownAjaxLink("/User/CreateCustomer", "AddMore", "")*@
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.DropDownList("CustomerUserId", null, "- Select From -", new { @id = "supplier" })@*<br />*@
                                        @Html.StarkDropDownAjaxLink("/User/CreateCustomer", "AddMore", "")
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.DropDownList("OrderNumber", (IEnumerable<SelectListItem>)ViewBag.OrderNumber, "select Order Number", new { @Id = "OrderNumber" })
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.receivedby, new { @class = "" })
                                        <input type="text" id="receivedby" name="receivedby" placeholder="Received by" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <table class="table table-bordered table-hover" id="tab_logic">
                                        <thead>
                                            <tr>
                                                <th style="width:30%">Product Name</th>
                                                <th style="width:30%">Description</th>
                                                <th style="width:10%">Quantity</th>
                                                <th style="width:30%">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td id="partialDiv ">
                                                    @Html.DropDownList("ProductId", null, "- Select Product -", new { @id = "productid" })<br />
                                                </td>
                                                <td>
                                                    <input type="text" id="description" name="description" placeholder="Description" class="form-control" />
                                                </td>
                                                <td>
                                                    <input type="number" id="quantity" name="quantity" placeholder="Quantity" class="form-control" />
                                                </td>
                                                <td>
                                                    <input type="text" id="status" name="status" placeholder="status" class="form-control" />
                                                </td>
                                                <td style="display:none">
                                                    <input type="text" id="Name" name="name" placeholder="Name" class="form-control" />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <div class="col-md-12">
                                        <a id="addToList" class="btn btn-primary">Add To List</a>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <table id="detailsTable" class="table table-bordered table-hover">
                                        <thead>
                                            <tr>
                                                <th style="width:10%">Product Id</th>
                                                <th style="width:30%">Product Name</th>
                                                <th style="width:25%">Description</th>
                                                <th style="width:10%">Quantity</th>
                                                <th style="width:20%">Status</th>
                                                <th style="width:5%"></th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <div class="box-footer">
                            <button id="saveOrder" type="submit" class="btn btn-primary">Create New Transfer</button>
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-primary" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

<script>
    $(document).ready(function () {

        $("#productid").on("change", function () {
            var selectedProductId = $(this).children("option:selected").val();
            var value = $('#dropDownId:selected').val();
            console.log(value);
            $.ajax(
                {
                    url: '/Product/GetDetails?id=' + $(this).children("option:selected").val(),
                    type: 'GET',
                    data: "",
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {
                        $("#description").val(data.description);
                        $("#Name").val(data.Name);

                    },
                    error: function () {
                        alert("error");
                    }
                });
        });
    });
    //Add Multiple Materails.
    $("#addToList").click(function (e) {
        e.preventDefault();

        // if ($.trim($("#quantity").val()) == "" || $.trim($("#description").val()) == "" || $.trim($("#unitPrice").val()) == "") return;

        var quantity = $("#quantity").val(),
            produtId = $("#productid").val(),
            description = $("#description").val(),
            status = $("#status").val(),
            name = $("#Name").val(),
            detailsTableBody = $("#detailsTable tbody");

        var productItem = '<tr><td>' + produtId + '</td><td>' + name + '</td><td>' + description + '</td><td>' + quantity + '</td><td>' + status + '</td><td><a data-itemId="0" href="#" class="deleteItem">Remove</a></td></tr>';
        detailsTableBody.append(productItem);
        clearItem();
    });
    //After Add A New Material In The List, Clear Clean The Form For Add More Material.
    function clearItem() {
        $("#quantity").val('');
        $("#description").val('');
        $("#status").val('');

    }
    // After Add A New Order In The List, If You Want, You Can Remove It.
    $(document).on('click', 'a.deleteItem', function (e) {
        e.preventDefault();
        var $self = $(this);
        if ($(this).attr('data-itemId') == "0") {
            $(this).parents('tr').css("background-color", "#ff6347").fadeOut(800, function () {
                $(this).remove();
            });
        }
    });

    //After Click Save Button Pass All Data View To Controller For Save Database
    function saveOrder(data) {
        return $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            type: 'POST',
            url: "/GRV/Create",
            data: data,
            success: function (result) {
                alert(result);
                location.reload();
            },
            error: function () {
                alert("Error!")
            }
        });
    }
    //Collect Multiple JobCard List For Pass To Controller
    $("#saveOrder").click(function (e) {
        e.preventDefault();

        var GRVArr = [];

        GRVArr.length = 0;

        $.each($("#detailsTable tbody tr"), function () {
            GRVArr.push({
                ProductId: $(this).find('td:eq(0)').html(),
                Description: $(this).find('td:eq(2)').html(),
                quantity: $(this).find('td:eq(3)').html(),
                status: $(this).find('td:eq(4)').html(),
                //unitPrice: $(this).find('td:eq(2)').html(),
                //TotalPrice: $(this).find('td:eq(3)').html()
            });
        });

        var data = JSON.stringify({
            receivedby: $("#receivedby").val(),
            OrderNumber: $("#OrderNumber").val(),
            supplier: $("#supplier").val(),
            approved: false,
            Warehouse: $("#warehouse").val(),
            GRVMaterials: GRVArr
        });

        $.when(saveOrder(data)).then(function (response) {
            console.log(response);
        }).fail(function (err) {
            console.log(err);
        });
    });
</script>


