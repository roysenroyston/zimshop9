@model ShopMate.Models.Product

@{
    ViewBag.Title = "Create";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

<script src="~/Content/ckeditor/ckeditor.js"></script>
<script src="~/Scripts/quagga.js"></script>

@Html.StarkAjaxFormSubmiter("frmProduct", "tbProduct", true, "Action Successfully Executed")

@if (!Ajax.IsThisAjaxRequest())
{
    <section class="content-header">
        <h1>@ViewBag.Title <small>Add a new product</small></h1>
    </section>
}

<script type="text/javascript">
    $(function () {
        $('select').searchableOptionList({ maxHeight: '250px' });
    });

    let data = '';
    window.onload = function () {
        window.document.body.addEventListener('keydown', function (event) {
            if (event.keyCode == 13 || event.keyCode == 16 || event.keyCode == 17) {
                event.preventDefault();
                return;
            }
            if (event.ctrlKey) {
                event.preventDefault();
                return;
            }
            data += event.key;
        });
    };

    function order_by_occurrence(arr) {
        var counts = {};
        arr.forEach(function (value) {
            if (!counts[value]) { counts[value] = 0; }
            counts[value]++;
        });
        return Object.keys(counts).sort(function (curKey, nextKey) {
            return counts[curKey] < counts[nextKey];
        });
    }

    function load_quagga() {
        if ($('#barcode-scanner').length > 0 && navigator.mediaDevices && typeof navigator.mediaDevices.getUserMedia === 'function') {
            Quagga.init({
                inputStream: {
                    name: "Live",
                    type: "LiveStream",
                    numOfWorkers: navigator.hardwareConcurrency,
                    target: document.querySelector('#barcode-scanner')
                },
                decoder: {
                    readers: ['ean_reader', 'ean_8_reader', 'code_39_reader', 'code_39_vin_reader', 'codabar_reader', 'upc_reader', 'upc_e_reader']
                }
            }, function (err) {
                if (err) { console.log(err); return; }
                Quagga.initialized = true;
                Quagga.start();
            });

            var last_result = [];
            if (Quagga.initialized == undefined) {
                Quagga.onDetected(function (result) {
                    var last_code = result.codeResult.code;
                    last_result.push(last_code);
                    if (last_result.length > 20) {
                        code = order_by_occurrence(last_result)[0];
                        last_result = [];
                        Quagga.stop();
                        $("#hdnBarcode").val(last_code);
                    }
                });
            }
        }
    };

    function clearTextbox() {
        $("#Name").val('');
        $("#hdnBarcode").val('');
        $("#PurchasePrice").val('');
        $("#SalePrice").val('');
        $("#Discount").val('');
        $("#HSN").val('');
    }

    $(document).ready(function () {
        $('#RefreshPage').click(function () {
            setTimeout(function () { window.location.reload(true); }, 800);
        });
    });
</script>

@using (Html.BeginForm("Create", "Product", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmProduct" }))
{
    @Html.AntiForgeryToken()

    <section class="content">
        <div id="barcode-scanner" style="display:none;"></div>
        <div class="row">
            <div class="col-12">
                <div class="box box-solid box-primary">
                    <div class="box-header">
                        <h3 class="box-title">Product details</h3>
                    </div>

                    <div role="form">
                        <div class="box-body zm-form">
                            <div class="zm-form-section-title" style="margin-top:0;border:none;padding-top:0;">Basic information</div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        @Html.LabelFor(model => model.Name, new { @class = "form-label" })
                                        @Html.TextBoxFor(model => model.Name, new { @id = "Name", @class = "form-control", placeholder = "Product name" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        @Html.LabelFor(model => model.BarCode, new { @class = "form-label" })
                                        @Html.TextBoxFor(model => model.BarCode, new { @class = "form-control", @id = "hdnBarcode", placeholder = "Scan or enter barcode" })
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="mb-3">
                                        @Html.LabelFor(model => model.ProductDescription, new { @class = "form-label" })
                                        @Html.TextAreaFor(model => model.ProductDescription, new { @id = "Description", @class = "form-control", rows = 3, placeholder = "Optional description" })
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        <label class="form-label" for="productType">Product type</label>
                                        <select name="ProductType" id="productType" class="form-select">
                                            <option value="0">Select product type</option>
                                            <option value="SINGLE">Single</option>
                                            <option value="CASE">Case</option>
                                        </select>
                                    </div>
                                </div>
                            </div>

                            <div class="zm-form-section">
                                <div class="zm-form-section-title">Packaging &amp; case</div>
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <div class="mb-3 zm-field-with-action">
                                            <label class="form-label" for="ProductCaseId">Product case</label>
                                            <small class="form-text">Required only if the product is not a single or case parent.</small>
                                            @Html.DropDownList("ProductCaseId", null, "- Select product case -", new { @class = "form-select" })
                                            @Html.StarkDropDownAjaxLink("/Product/Create", "AddMore", "")
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            @Html.LabelFor(model => model.NumOfSinglesInCase, new { @class = "form-label" })
                                            @Html.TextBoxFor(model => model.NumOfSinglesInCase, new { @id = "NumOfSinglesInCase", @class = "form-control", type = "number", min = "1" })
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="mb-3">
                                            @Html.LabelFor(model => model.Units, new { @class = "form-label" })
                                            @Html.TextBoxFor(model => model.Units, new { @id = "Units", @class = "form-control", type = "number", min = "0" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="zm-form-section">
                                <div class="zm-form-section-title">Pricing</div>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            @Html.LabelFor(model => model.PurchasePrice, new { @class = "form-label" })
                                            @Html.TextBoxFor(model => model.PurchasePrice, new { @id = "PurchasePrice", @class = "form-control", type = "number", step = "0.01", min = "0" })
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            @Html.LabelFor(model => model.SalePrice, new { @class = "form-label" })
                                            @Html.TextBoxFor(model => model.SalePrice, new { @id = "SalePrice", @class = "form-control", type = "number", step = "0.01", min = "0" })
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            @Html.LabelFor(model => model.UnitSalePrice, new { @class = "form-label" })
                                            @Html.TextBoxFor(model => model.UnitSalePrice, new { @id = "UnitSalePrice", @class = "form-control", type = "number", step = "0.01", min = "0" })
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="zm-form-section">
                                <div class="zm-form-section-title">Inventory &amp; tax</div>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            @Html.LabelFor(model => model.StockAlert, new { @class = "form-label" })
                                            @Html.TextBoxFor(model => model.StockAlert, new { @class = "form-control", type = "number", min = "0" })
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3 zm-field-with-action">
                                            @Html.LabelFor(model => model.TaxId, new { @class = "form-label" })
                                            @Env.TaxUC(1)
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="mb-3">
                                            <div class="form-check">
                                                @Html.CheckBoxFor(model => model.IsActive, new { @class = "form-check-input" })
                                                @Html.LabelFor(model => model.IsActive, new { @class = "form-check-label" })
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div hidden>
                                @Html.DropDownList("ProductCategoryId", null, "- Select -")
                                @Html.Hidden("AddedBy", Env.GetUserInfo("userid"))
                                @Html.Hidden("DateAdded", DateTime.Now)
                                @Html.Hidden("ModifiedBy", Env.GetUserInfo("userid"))
                                @Html.Hidden("DateModied", DateTime.Now)
                                <input id="ProductImage" name="ProductImage" type="file" />
                                @Html.TextBoxFor(model => model.Discount, new { @Id = "Discount", @class = "form-control" })
                                @Html.DropDownList("WareHouse", null, "- Select -")
                            </div>
                        </div>

                        <div class="box-footer">
                            <input type="submit" id="RefreshPage" value="Create product" class="btn btn-primary" />
                            @Html.ActionLink("Back to list", "Index", null, new { @class = "btn btn-outline-secondary" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
