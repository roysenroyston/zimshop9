    function GrossAmount(amount,Tamount)
    {




        var oldTax = $("#GrossTax").val();
        var newTaxAmount = parseFloat(oldTax) + parseFloat(Tamount);

        $("#GrossTax").val(newTaxAmount);


   
        var oldAmount = $("#subtotal").val();
        var total = parseFloat(oldAmount) + parseFloat(amount);

        var grossAmount = total + newTaxAmount;

        $("#subtotal").val(total);

        $("#GrossAmount").val(grossAmount);

        

        CustomerChange();
    }

    function CustomerChange() {

        var fromcustomer = $("#tmoney").val();

        var gross = $("#GrossAmount").val();
       // var gross = $("#NewID").val();
        var change = fromcustomer - parseFloat(gross);
        $("#ichange").val(change.toFixed(2));
        $("#tenderedmoney").text(fromcustomer);

    }
