    currenciesList.addEventListener("focusout", currenciesListFocusOut);

    function currenciesListFocusOut(event) {
        const inputValue = event.target.value;
        if (isNaN(inputValue) || Number(inputValue) === 0) event.target.value = "";
        else event.target.value = Number(inputValue).toFixed(4);
    }

    currenciesList.addEventListener("keydown", currenciesListKeyDown);

    function currenciesListKeyDown(event) {
        if (event.key === "Enter") event.target.blur();
    }
    // Auxiliary Functions
</script>

<section class="content pos-page">
    <div class="pos-page-header">
        <h1>Point Of Sale</h1>
        <div class="pos-toolbar">
            <a href="~/Sale/" class="btn btn-outline-secondary btn-sm">Go To Sale List</a>
            <button id="accountpay" class="btn btn-success btn-sm" data-bs-target="#progressmodal" data-bs-toggle="modal">Account Payment</button>
        </div>
    </div>

    <div class="row pos-layout">
        <div class="col-xs-4 col-lg-4 pos-products-panel">
            <div class="pos-panel">
                <table id="tbProduct" class="display table table-striped w-100">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th style="width: 90px;">Qty</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <div class="col-xs-8 col-lg-8 pos-checkout-panel">
            <div id="barcode-scanner" style="display:none;"></div>

            <div id="dvContainer" class="pos-document">
                <div class="pos-page-title">Sale Cart</div>

                <div class="table-responsive">
                    <table id="tbInvoiceItem" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Product Name</th>
                                <th>Price</th>
                                <th>Tax</th>
                                <th>Quantity</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody id="tbody"></tbody>
                        <tfoot>
                            <tr>
                                <th></th>
                                <th>Subtotal</th>
                                <th><input id="subtotal" value="0" readonly /></th>
                                <th>Gross Tax</th>
                                <th><input id="GrossTax" value="0" readonly /></th>
                            </tr>
                            <tr>
                                <th></th>
                                <th colspan="2"></th>
                                <th>Gross Amount</th>
                                <th><input id="GrossAmount" value="0" readonly /></th>
                            </tr>
                            <tr>
                                <th></th>
                                <th>From Customer</th>
                                <th><input type="number" id="tmoney" onkeyup="CustomerChange();" readonly /></th>
                                <th>Customer Change</th>
                                <th><input id="ichange" value="0" readonly /></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="pos-currency-row">
                    @Html.DropDownList("PaymentModes", null, "-Select Currency-", new { @id = "currencyDropDown", @class = "form-select" })
                    <input id="NewID" value="0" readonly class="form-control" style="max-width:120px;" />
                </div>

                <div id="divPayout" style="display:none;">
                    <div style="display:none">
                        @Html.DropDownList("CustomerUserId", " -Select Customer- ")<br />
                    </div>

                    <table class="pos-payment-grid">
                        <thead>
                            <tr>
                                <th>Cash ZWG</th>
                                <th>ZIPIT</th>
                                <th>ECOCASH</th>
                                <th>ECOCASHUSD</th>
                                <th>Cash Usd</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><input value="0" type="number" class="form-control" id="cashtxt" /></td>
                                <td><input value="0" type="number" class="form-control" id="swipetxt" /></td>
                                <td><input value="0" type="number" class="form-control" id="ecocashtxt" /></td>
                                <td><input value="0" type="number" class="form-control" id="telecashtxt" /></td>
                                <td><input value="0" type="number" class="form-control" id="usdtxt" /></td>
                            </tr>
                        </tbody>
                    </table>

                    <div style="display:none">
                        @Html.DropDownList("PaymentModes", " -Select Payment Mode- ")<br />
                        <input type="text" id="SaleNote" placeholder="Any Remarks" value="Sale" style="width:325px" />
                    </div>

                    <button type="button" id="btnPayOut" class="btn btn-primary mt-3">PayOut And Print</button>
                </div>

                <div class="pos-footer-meta">
                    <span>@DateTime.Now.ToString("dd/MMM/yyyy hh:mm:tt")</span>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="progressmodal" data-keyboard="false" data-bs-backdrop="static" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title">Account Payment</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="progrdata">
                    <div class="form-group mb-3">
                        <label id="pincdelb" class="form-label">Customer Name</label>
                        @Html.DropDownList("UserId", null, new { @id = "usID", @class = "form-select" })
                        @Html.StarkDropDownAjaxLink("/User/CreateCustomer", "AddMore", "")
                    </div>
                    <div class="form-group mb-3">
                        <label class="form-label">Enter Amount Paid</label>
                        <input type="number" id="amount" class="form-control" readonly />
                    </div>
                    <div class="form-group mb-3">
                        <label for="paymentfor" class="form-label">Payment For</label>
                        <textarea id="paymentfor" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="table-responsive">
                        <table class="pos-payment-grid">
                            <thead>
                                <tr>
                                    <th>Cash</th>
                                    <th>Ecocash</th>
                                    <th>Swipe</th>
                                    <th>Telecash</th>
                                    <th>OneMoney</th>
                                    <th>USD</th>
                                    <th>Rand</th>
