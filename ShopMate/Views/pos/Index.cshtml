    function updatep() {

        $("#upbtn").click(function () {


            var catId = $("#usID").val();
            var pernt = $("#amount").val();
            var payment = $("#paymentfor").val();
            var cashacc = $("#cashaccount").val();
            var eco = $("#ecocashaccount").val();
            var swip = $("#swipeaccount").val();
            var telecashacc = $("#telecashaccount").val();
             var onemoneyacc = $("#onemoneyaccount").val();
            var usdacc = $("#usdhaccount").val();
            var randacc = $("#randaccount").val();
            var pulaacc = $("#pulaaccount").val();
            $.ajax({
                type: "POST",
                //url: "~/UpdatePrice?Id=" + catId + "&addprice=" + pernt + "",
                url: "@Url.Action("Accountpay", "pos")?Ids=" + catId + " &addbalance= " + pernt + " &description=" + payment + " &cash=" + cashacc + " &ecocash=" + eco + " &swipe=" + swip + "&telecash ="+ telecashacc +"&onemoney ="+ onemoneyacc +"&usd ="+ usdacc +"&rand ="+ randacc +"&pula ="+ pulaacc +"",

                datatype: "json",
                data: '{Ids:' + catId + ', addbalance: "' + pernt + '",description: "' + payment + '",cash: "' + cashacc + '",ecocash: "' + eco + '",swipe: "' + swip + '",telecash: "' + telecashacc + '",onemoney: "' + onemoneyacc + '",usd: "' + usdacc + '",rand: "' + randacc + '",pula: "' + pulaacc + '" }',
                success: function () {

                    $("#upbtn").closest("tr").find("td:eq(4)").text(400);
                    $('#progressmodal').modal('hide');


                },
                error: function (req, textStatus, errorThrown) {
                    //this is going to happen when you send something different from a 200 OK HTTP
                    alert('Ooops, something happened: ' + textStatus + ' ' + errorThrown);
                }

            });


        });
    }
