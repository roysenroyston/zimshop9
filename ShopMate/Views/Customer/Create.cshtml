@model ShopMate.Models.Customers

@{
    ViewBag.Title = "Create";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

<script src="~/Content/ckeditor/ckeditor.js"></script>
<script src="~/Scripts/quagga.js"></script>
<link href="~/Content/Site.css" rel="stylesheet" />

@Html.StarkAjaxFormSubmiter("frmCurrencies", "tbCurrencies", true, "Action Successfully Executed")

@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
            <h1>
                @ViewBag.Title
                <small>@ViewBag.Title</small>
            </h1>
        </section>
    }
}

<script type="text/javascript">
    $(function () {
        $('select').searchableOptionList({
            maxHeight: '250px'
        });
    });


    $(document).ready(function () {

        //  load_quaga();
    });
    //clear things
    function clearTextbox() {
        $("#Name").val('');
    }
</script>
@using (Html.BeginForm("Create", "Customer", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmCurrencies" }))
{
    @Html.AntiForgeryToken()

    <section class="content">
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-solid box-primary">
                    <div class="box-header">
                        <h3 class="box-title">Fill Currency Form</h3>
                    </div>
                    <div role="form">
                        <div class="box-body" id="barcode-scanner">
                            <div id="barcode-scanner"></div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.BuyerTradeName, new { @class = "" })
                                @Html.EditorFor(model => model.BuyerTradeName, new { @Id = "BuyerTradeName", @class = "form-control" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.BuyerRegisterName, new { @class = "" })
                                @Html.EditorFor(model => model.BuyerRegisterName, new { @Id = "BuyerRegisterName", @class = "form-control" })
                            </div>


                            <div class="form-group">
                                @Html.LabelFor(model => model.BuyerTIN, new { @class = "" })
                                @Html.EditorFor(model => model.BuyerTIN, new { @Id = "BuyerTIN", @class = "form-control" })
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.VATNumber, new { @class = "" })
                                @Html.EditorFor(model => model.VATNumber, new { htmlAttributes = new { @class = "form-control", @id = "VATNumber" } })
                            </div>
                            <div class="form-group">

                                @Html.LabelFor(model => model.Email, new { @class = "" })
                                @Html.EditorFor(model => model.Email, new { @Id = "Email", @class = "form-control" })
                            </div>

                            <div class="form-group">

                                @Html.LabelFor(model => model.PhoneNo, new { @class = "" })
                                @Html.EditorFor(model => model.PhoneNo, new { @Id = "PhoneNo", @class = "form-control" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.Province, new { @class = "" })
                                @Html.EditorFor(model => model.Province, new { @Id = "Province", @class = "form-control" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.City, new { @class = "" })
                                @Html.EditorFor(model => model.City, new { @Id = "City", @class = "form-control" })

                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.HouseNo, new { @class = "" })
                                @Html.EditorFor(model => model.HouseNo, new { @Id = "HouseNo", @class = "form-control" })
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(model => model.Street, new { @class = "" })
                                @Html.EditorFor(model => model.Street)
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.isActive, new { @class = "" })
                                @Html.EditorFor(model => model.isActive)
                            </div>

                            <div class="form-group" hidden>
                                @Html.LabelFor(model => model.WarehouseId, new { @class = "" })
                                @Env.WareHouseUC(1)
                            </div>




                        </div>
                        <div class="box-footer">
                            @*<input type="submit" value="Create New" class="btn btn-primary" onclick="clearTextbox();">*@
                            @*@Html.StarkInputButtion("Create New","submit","btn btn-primary","")*@
                            <input type="submit" id="RefreshPage" value="Create New" class="btn btn-primary">
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-primary" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

}
