@model IEnumerable<ShopMate.ModelDto.StockAlertDto>
@{
    ViewBag.Title = "Stock Alert";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.MenuOpen = "Reports";
}

<div class="report-page-header">
    <div>
        <h1>Stock Alert Report</h1>
        <p>Products at or below their stock alert threshold.</p>
    </div>
    <div class="report-toolbar no-print">
        <button type="button" class="btn btn-outline-secondary" id="btnPrint">
            <i class="bi bi-printer"></i> Print
        </button>
    </div>
</div>

<section class="content report-page">
    <div class="row">
        <div class="col-xs-12">
            <div id="dvContainer" class="report-document">
                <div class="report-document-header">
                    <h2 class="report-company-name">@ViewBag.company</h2>
                    <h3 class="report-title">Stock Alert Report</h3>
                </div>

                <div class="table-responsive report-table-wrap">
                    <table id="tbInvoiceItem" class="table table-striped report-table">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Product Name</th>
                                <th>Stock Alert Value</th>
                                <th>Remaining Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                int i = 1;
                                foreach (var item in Model)
                                {
                                    if (item.StockAlert >= item.Quantity)
                                    {
                                        <tr class="row-alert">
                                            <td>@i</td>
                                            <td>@item.ProductName</td>
                                            <td>@item.StockAlert</td>
                                            <td>@item.Quantity</td>
                                        </tr>
                                        i++;
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="report-document-footer">
                    <span>@DateTime.Now.ToString("dd/MMM/yyyy hh:mm:tt")</span>
                    <span>Printed by: @Env.GetUserInfo("name")</span>
                </div>
            </div>
        </div>
    </div>
</section>
