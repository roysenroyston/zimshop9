@model ShopMate.Models.Van

@{
    ViewBag.Title = "Create";
}

@{
    ViewBag.Title = "Create";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

<script src="~/Content/ckeditor/ckeditor.js"></script>
<script src="~/Scripts/quagga.js"></script>
<link href="~/Content/Site.css" rel="stylesheet" />

@Html.StarkAjaxFormSubmiter("frmVan", "tbVan", true, "Action Successfully Executed")

@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
            <h1>
                @ViewBag.Title
                <small>@ViewBag.Title</small>
            </h1>
        </section>
    }
}
<script type="text/javascript">
    $(function () {
        $('select').searchableOptionList({
            maxHeight: '250px'
        });
    });




    $(document).ready(function () {

        //  load_quaga();
    });
    //clear things
    function clearTextbox() {
        $("#RegNumber").val('');
        $("#Active").val('');
    }

    $(document).ready(function () {
        $('#RefreshPage').click(function () {

            setTimeout(
                function () {
                    window.location.reload(true);
                }, 800);
        });
    });
</script>
@using (Html.BeginForm("Create", "Van", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmVan" }))
{
    @Html.AntiForgeryToken()
    <section class="content">
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-solid box-primary">
                    <div class="box-header">
                        <h3 class="box-title">Fill Van Form</h3>
                    </div>
                    <div role="form">
                        <div class="box-body">
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                            <div class="form-group">
                                @Html.LabelFor(model => model.RegNumber, htmlAttributes: new { @class = "" })
                                @Html.EditorFor(model => model.RegNumber, new { htmlAttributes = new { @class = "form-control", @id = "RegNumber" } })
                                @Html.ValidationMessageFor(model => model.RegNumber, "", new { @class = "text-danger" })
                            </div>
                            <div class="form-group">
                                @Html.LabelFor(model => model.IsActive, new { @class = "" })
                                @Html.EditorFor(model => model.IsActive)
                            </div>
                            <div class="form-group">
                                @*@Html.LabelFor(model => model.WarehouseId, htmlAttributes: new { @class = "" })
            @Html.EditorFor(model => model.WarehouseId, new { htmlAttributes = new { @class = "form-control", @id = "WarehouseId" } })
            @Html.ValidationMessageFor(model => model.WarehouseId, "", new { @class = "text-danger" })*@
                                @Html.DropDownList("WarehouseId", null, "- Select Warehouse -", new { @id = "warehouseid" })<br />
                            </div>

                            <div class="box-footer">
                                @*<input type="submit" value="Create New" class="btn btn-primary" onclick="clearTextbox();">*@
                                @*<input type="submit" value="Create" class="btn btn-default" />*@
                                <input type="submit" id="RefreshPage" value="Create New" class="btn btn-primary">
                                @*@Html.StarkInputButtion("Create New", "submit", "btn btn-primary", "")*@
                                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-primary" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}