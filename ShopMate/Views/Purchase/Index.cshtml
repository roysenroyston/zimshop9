@{
    ViewBag.Title = "Voucher List";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.MenuOpen = "Purchase";
}
@section ScriptsOrCss
{

    <link href="~/Content/DataTable/new/dataTables.bootstrap.css" rel="stylesheet" type="text/css" />
    <script src="~/Content/DataTable/new/jquery.dataTables.min.js" type="text/javascript"></script>
    <script src="~/Content/DataTable/new/dataTables.buttons.min.js" type="text/javascript"></script>
    <script src="~/Content/DataTable/new/jszip.min.js" type="text/javascript"></script>
    <script src="~/Content/DataTable/new/pdfmake.min.js" type="text/javascript"></script>
    <script src="~/Content/DataTable/new/vfs_fonts.js" type="text/javascript"></script>
    <script src="~/Content/DataTable/new/buttons.html5.min.js" type="text/javascript"></script>
    <link href="~/Content/DataTable/new/jquery.dataTables.min.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/DataTable/new/buttons.dataTables.min.css" rel="stylesheet" type="text/css" />
    <script src="~/Content/DataTable/new/buttons.print.min.js"></script>
    <script src="~/Content/DataTable/new/buttons.colVis.min.js"></script>
}
<section class="content-header">
    <h1>
        @ViewBag.Title
        <small> @ViewBag.Title</small>
    </h1>
</section>

<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">
            <div class="box box-solid box-primary">

                <div class="box-body">
                    <!-- Split button -->
                    <div class="margin">
                        @*<div class="btn-group">
                                @Ajax.ModalDialogActionLink("Create Quick", "Create", "Create ", "btn btn-dropbox")
                            </div>*@
                        <div class="btn-group">
                            @*<a href="~/pos/purchase" class="btn btn-default">New Purchase</a>*@
                            <a href="~/Purchase/Create" class="btn btn-default">Receive Stock</a>
                        </div>
                    </div>
                    <!-- flat split buttons -->
                </div><!-- /.box-body -->
            </div>
            <div class="box box-solid box-primary">
                <div class="box-header">
                    <h3 class="box-title">@ViewBag.Title</h3>
                </div><!-- /.box-header -->
                <div class="box-body table-responsive">

                    <div class="margin">

                        <div class="streaming-table">
                            <span class="label label-success">Purchased</span>
                            <span class="label label-danger">Returned</span>
                            <br />
                            <span id="found" class="label label-info"></span>


                            <table id="tbPurchase" class="display nowrap">
                                <thead>
                                    <tr>
                                        <th>Actions</th>
                                        <th> Id  </th>
                                        @*<th>Invoice Number</th>*@
                                        <th> Supplier </th>
                                        <th> Product  </th>
                                        <th> Quantity  </th>
                                        <th> Returned Quantity  </th>
                                        <th> Purchase Price  </th>
                                        <th> Total Amount  </th>
                                        <th> Vat Amount  </th>
                                        <th> Total Amount WithTax </th>
                                        <th> Date Added  </th>
                                        <th> Added By  </th>


                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>

                            <div id="summary">
                                <div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>





<script type="text/javascript">

    $(document).ready(function () {
        var oTablePurchase = "";
        var ControlerNamePurchase = "@Url.Content("~/Purchase")";
        // debugger;
        oTablePurchase = $("#tbPurchase").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Purchase/GetGrid")",
            "buttons": [
                 { extend: 'copyHtml5', exportOptions: { columns: ':visible' } }
                , { extend: 'excelHtml5', exportOptions: { columns: ':visible' } }
                , { extend: 'csvHtml5', exportOptions: { columns: ':visible' } }
                , { extend: 'pdfHtml5', exportOptions: { columns: ':visible' } }
                , { extend: 'print', exportOptions: { columns: ':visible' } }
                , 'colvis'
            ], columnDefs: [{ visible: false }],
            "pageLength": 10,
            "lengthMenu": [[5, 10, 25, 50, -1], [5, 10, 25, 50, "All"]],
            "aoColumns": [

            {
                "mRender": function (oObj, type, row) {

                    var buttons = '<div class="text-center"> <div class="btn-group text-left"> <button type="button" class="btn btn-default btn-xs btn-warning dropdown-toggle" data-toggle="dropdown">Action <span class=""></span></button>';
                    buttons += '<ul class="dropdown-menu pull-left" role="menu">';
                    if (row[5] == 0)
                    {
                        buttons += '<li><a href="' + ControlerNamePurchase + "/PurchaseReturn/" + row[0] + '?qty=' + row[4] + '" data-ajax-update="#SkReturn" data-ajax-success="openModalDialog(\'SkReturn\', \'Return\')" data-ajax-mode="return" data-ajax-method="GET" data-ajax-failure="clearModalDialog(\'SkReturn\');alert(\'Ajax call failed\')" data-ajax-begin="prepareModalDialog(\'SkReturn\')" data-ajax="true"><i class="fa fa-undo"></i> Return</a></a></li>';
                    }
                    if (row[5] > 0)
                    {
                   /*      buttons += '<li><a href="' + ControlerNamePurchase + "/PurchaseReturn/" + row[0] + '?qty=' + row[5] + '" data-ajax-update="#SkReturn" data-ajax-success="openModalDialog(\'SkReturn\', \'Return\')" data-ajax-mode="return" data-ajax-method="GET" data-ajax-failure="clearModalDialog(\'SkReturn\');alert(\'Ajax call failed\')" data-ajax-begin="prepareModalDialog(\'SkReturn\')" data-ajax="true"><i class="fa fa-undo"></i> Replace</a></a></li>';*/

                        //buttons += '<li><a href="' + ControlerNamePurchase + "/PurchaseReplace/" + row[0] + '?qty=' + row[5] + '" data-ajax-update="#SkReplace" data-ajax-success="openModalDialog(\'SkReplace\', \'Replace\')" data-ajax-mode="replace" data-ajax-method="GET" data-ajax-failure="clearModalDialog(\'SkReturn\');alert(\'Ajax call failed\')" data-ajax-begin="prepareModalDialog(\'SkReturn\')" data-ajax="true"><i class="fa fa-undo"></i> Replace</a></a></li>';
                    }
                    
                   // buttons += '<li class="divider"></li>';
                    //buttons += '<li><a href="' + ControlerNamePurchase + "/Delete/" + row[0] + '" data-ajax-update="#SkDelete" data-ajax-success="openModalDialog(\'SkDelete\', \'Delete\')" data-ajax-mode="replace" data-ajax-method="GET" data-ajax-failure="clearModalDialog(\'SkDelete\');alert(\'Ajax call failed\')" data-ajax-begin="prepareModalDialog(\'SkDelete\')" data-ajax="true"><i class="fa fa-trash-o"></i> Delete</a></a></li>';

                    buttons += '</ul>';
                    buttons += '</div></div>';
                    return buttons;
                }

            }, {}
, {}, {}, {}
                , {}
, {}
                , {}
                , {}
                , {}
                , {}

                , {}
            ]
            , "rowCallback": function (row, data, index) {
                if (data[11] == 3)
                {
                    $('td', row).css('background-color', '#dd4b39');
                }
                else
                {
                    $('td', row).css('background-color', '#00a65a');
                }
                
            }

        });

    });
</script>

