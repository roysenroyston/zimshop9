@model ShopMate.ModelDto.HomeDto
@{
    ViewBag.Title = "Dashboard";
}

@section ScriptsOrCss
{
    <script src="https://code.highcharts.com/highcharts.js"></script>
    <script src="https://code.highcharts.com/modules/no-data-to-display.js"></script>
}

@{
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<div class="dashboard-hero">
    <h1>ZiPOS Dashboard</h1>
    <p>Sales, purchases, inventory, and profit at a glance.</p>
</div>

<section class="content">
    <div class="row mb-3">
        <div class="col-lg-6 col-md-8">
            <form action="" method="post" class="stat-card">
                <label class="stat-card-label mb-2">Report date</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fa fa-calendar"></i></span>
                    <input value="@ViewBag.dates" placeholder="dd/MM/yyyy" name="Date" class="form-control" type="text" />
                    <button class="btn btn-primary" type="submit">Get Report</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-2 col-md-4 col-sm-6">
            <div class="stat-card emerald">
                <div class="stat-card-label">Today Purchased</div>
                <p class="stat-card-value">@Model.todayPurchaseCount</p>
                <div class="stat-card-foot">
                    <a href="~/Report/TodayPurchase">View report <i class="fa fa-arrow-right"></i></a>
                </div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6">
            <div class="stat-card amber">
                <div class="stat-card-label">Today Sale Value</div>
                <p class="stat-card-value">@Model.todaySaleCostSum</p>
                <div class="stat-card-foot">
                    <a href="~/Report/TodaySale">View report <i class="fa fa-arrow-right"></i></a>
                </div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-sm-6">
            <div class="stat-card indigo">
                <div class="stat-card-label">Today Profit</div>
                <p class="stat-card-value">@Model.todayProfit</p>
            </div>
        </div>
        <div class="col-lg-6 col-md-12">
            <div class="stat-card sky">
                <div class="stat-card-label">Overall Stock Movement</div>
                <div class="row mt-2">
                    <div class="col-sm-6 col-md-3 mb-2">
                        <small class="text-muted d-block">Received</small>
                        <strong id="stock-received" class="text-muted">…</strong>
                    </div>
                    <div class="col-sm-6 col-md-3 mb-2">
                        <small class="text-muted d-block">Sold (total)</small>
                        <strong id="stock-sold" class="text-muted">…</strong>
                    </div>
                    <div class="col-sm-6 col-md-3 mb-2">
                        <small class="text-muted d-block">Remaining</small>
                        <strong id="stock-remaining" class="text-muted">…</strong>
                    </div>
                    <div class="col-sm-6 col-md-3 mb-2">
                        <small class="text-muted d-block">Sold today</small>
                        <strong>@Model.todaySaleCount</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>



    <div class="row g-3 mb-4">
        <div class="col-md-4 col-sm-6">
            <div class="info-box bg-green">
                <span class="info-box-icon"><i class="fa fa-user-plus"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Total Customers</span>
                    <span class="info-box-number">@Model.Customer</span>
                    <div class="progress"><div class="progress-bar" style="width: 100%"></div></div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="info-box bg-yellow">
                <span class="info-box-icon"><i class="fa fa-user-secret"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Total Suppliers</span>
                    <span class="info-box-number">@Model.Vendor</span>
                    <div class="progress"><div class="progress-bar" style="width: 100%"></div></div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="info-box bg-red">
                <span class="info-box-icon"><i class="fa fa-eye"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Total Roles</span>
                    <span class="info-box-number">@Model.Role</span>
                    <div class="progress"><div class="progress-bar" style="width: 100%"></div></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 dashboard-chart-row">
        <div class="col-md-5">
            <div class="box box-primary chart-panel">
                <div class="box-header with-border">
                    <h3 class="box-title">Due &amp; Expense</h3>
                    <div class="box-tools pull-right">
                        <button data-widget="collapse" class="btn btn-box-tool"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="box-body chart-responsive">
                    <div id="bindPieChart" class="zm-chart-host"></div>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="box box-primary chart-panel">
                <div class="box-header with-border">
                    <h3 class="box-title">Today's overview</h3>
                    <div class="box-tools pull-right">
                        <button data-widget="collapse" class="btn btn-box-tool"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="box-body chart-responsive">
                    <div id="otherInfo" class="zm-chart-host"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1 dashboard-chart-row">
        <div class="col-md-8">
            <div class="box box-primary chart-panel">
                <div class="box-header with-border">
                    <h3 class="box-title mb-0">Sales trend</h3>
                    <select id="selectLastDays" class="form-select form-select-sm ms-md-3">
                        <option value="7">Last 7 days</option>
                        <option value="30">Last 30 days</option>
                        <option value="60">Last 60 days</option>
                        <option value="90">Last 90 days</option>
                        <option value="120">Last 120 days</option>
                    </select>
                    <div class="box-tools pull-right">
                        <button data-widget="collapse" class="btn btn-box-tool"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="box-body chart-responsive">
                    <div id="line-chart" class="zm-chart-host"></div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="box box-primary chart-panel">
                <div class="box-header with-border">
                    <h3 class="box-title">Sales, purchases &amp; returns</h3>
                    <div class="box-tools pull-right">
                        <button data-widget="collapse" class="btn btn-box-tool"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="box-body chart-responsive">
                    <div id="work-chart" class="zm-chart-host"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-1">
        <div class="col-lg-8">
            <div class="box box-primary chart-panel">
                <div class="box-header with-border">
                    <h3 class="box-title">Fast moving products</h3>
                    <div class="box-tools pull-right">
                        <button data-widget="collapse" class="btn btn-box-tool"><i class="fa fa-minus"></i></button>
                    </div>
                </div>
                <div class="box-body chart-responsive">
                    <div id="Kyle" class="zm-chart-host"></div>
                </div>
                <a class="small-box-footer" href="~/Report/FastSale">View full report <i class="fa fa-arrow-right"></i></a>
            </div>
        </div>
    </div>




</section>

<script type="text/javascript">
    (function () {
        var colors = ['#6366f1', '#10b981', '#f59e0b', '#f43f5e', '#0ea5e9', '#8b5cf6', '#14b8a6'];

        Highcharts.setOptions({
            colors: colors,
            chart: {
                backgroundColor: '#ffffff',
                style: { fontFamily: "'Plus Jakarta Sans', system-ui, sans-serif" },
                spacing: [12, 12, 16, 12]
            },
            title: {
                style: { color: '#0f172a', fontSize: '14px', fontWeight: '600' }
            },
            credits: { enabled: false },
            legend: {
                itemStyle: { color: '#64748b', fontWeight: '500' }
            },
            lang: {
                noData: 'No data available for this period'
            },
            noData: {
                style: { color: '#64748b', fontSize: '13px', fontWeight: '500' }
            }
        });

        function baseChartOptions() {
            return {
                chart: { height: 300 },
                xAxis: {
                    labels: { style: { color: '#64748b' } },
                    lineColor: '#e2e8f0',
                    tickColor: '#e2e8f0'
                },
                yAxis: {
                    title: { text: null },
                    gridLineColor: '#eef2f7',
                    labels: { style: { color: '#64748b' } }
                },
                tooltip: {
                    backgroundColor: '#ffffff',
                    borderColor: '#e2e8f0',
                    borderRadius: 10,
                    shadow: false,
                    style: { color: '#0f172a' }
                }
            };
        }

        Highcharts.chart('bindPieChart', Highcharts.merge(baseChartOptions(), {
            chart: { type: 'pie', height: 300 },
            title: { text: 'Expense, due given & due return' },
            plotOptions: {
                pie: {
                    innerSize: '55%',
                    borderWidth: 0,
                    dataLabels: {
                        enabled: true,
                        format: '<b>{point.name}</b><br>{point.y:,.0f}',
                        style: { color: '#475569', fontWeight: '500', textOutline: 'none' }
                    }
                }
            },
            series: [{
                name: 'Amount',
                colorByPoint: true,
                data: [
                    { name: 'Expense', y: @Model.Expense.ToString(inv) },
                    { name: 'Due Given', y: @Model.DueGiven.ToString(inv) },
                    { name: 'Due Return', y: @Model.DueReturn.ToString(inv) }
                ]
            }]
        }));

        Highcharts.chart('otherInfo', Highcharts.merge(baseChartOptions(), {
            chart: { type: 'column', height: 300 },
            title: { text: "Today's purchase, sale, profit & dues" },
            xAxis: {
                categories: ['Purchase', 'Sale', 'Profit', 'Profit w/ Tax', 'Expense', 'Due Given', 'Due Return']
            },
            plotOptions: {
                column: {
                    borderRadius: 6,
                    borderWidth: 0,
                    colorByPoint: true
                }
            },
            series: [{
                name: 'Amount',
                data: [
                    @Model.todayPurchaseCostSum.ToString(inv),
                    @Model.todaySaleCostSum.ToString(inv),
                    @Model.todayProfit.ToString(inv),
                    @Model.todayProfitWithTax.ToString(inv),
                    @Model.Expense.ToString(inv),
                    @Model.DueGiven.ToString(inv),
                    @Model.DueReturn.ToString(inv)
                ],
                showInLegend: false
            }]
        }));

        Highcharts.chart('work-chart', Highcharts.merge(baseChartOptions(), {
            chart: { type: 'pie', height: 300 },
            title: { text: 'Sales, purchases & returns' },
            plotOptions: {
                pie: {
                    innerSize: '50%',
                    borderWidth: 0,
                    dataLabels: {
                        enabled: true,
                        format: '<b>{point.name}</b><br>{point.y:,.0f}',
                        style: { color: '#475569', fontWeight: '500', textOutline: 'none' }
                    }
                }
            },
            series: [{
                name: 'Items',
                colorByPoint: true,
                data: [
                    { name: 'Purchases', y: @Model.todayPurchaseCount },
                    { name: 'Sales', y: @Model.todaySaleCount },
                    { name: 'Purchase returns', y: @Model.todayPurchaseReturnCount },
                    { name: 'Sale returns', y: @Model.todaySaleReturnCount }
                ]
            }]
        }));

        function renderLineChart(data) {
            var categories = [];
            var values = [];
            if (data && data.length) {
                for (var i = 0; i < data.length; i++) {
                    categories.push(data[i].label);
                    values.push(parseFloat(data[i].value) || 0);
                }
            }

            Highcharts.chart('line-chart', Highcharts.merge(baseChartOptions(), {
                chart: { type: 'areaspline', height: 300 },
                title: { text: 'Sales trend' },
                xAxis: { categories: categories },
                plotOptions: {
                    areaspline: {
                        fillOpacity: 0.15,
                        lineWidth: 3,
                        marker: { radius: 4, fillColor: '#ffffff', lineWidth: 2, lineColor: '#6366f1' }
                    }
                },
                series: [{
                    name: 'Units sold',
                    color: '#6366f1',
                    data: values,
                    showInLegend: false
                }]
            }));
        }

        function renderProductChart(data) {
            var categories = [];
            var values = [];
            if (data && data.length) {
                for (var i = 0; i < data.length; i++) {
                    categories.push(data[i].label);
                    values.push(parseFloat(data[i].value) || 0);
                }
            }

            Highcharts.chart('Kyle', Highcharts.merge(baseChartOptions(), {
                chart: { type: 'bar', height: 300 },
                title: { text: 'Fast moving products' },
                xAxis: { categories: categories },
                plotOptions: {
                    bar: {
                        borderRadius: 6,
                        borderWidth: 0,
                        colorByPoint: true
                    }
                },
                series: [{
                    name: 'Units sold',
                    data: values,
                    showInLegend: false
                }]
            }));
        }

        function bindLastRegister(days) {
            $.ajax({
                url: '@Url.Content("~/Home/LineChart")',
                type: 'POST',
                data: { lastDay: days },
                dataType: 'json',
                success: renderLineChart,
                error: function () { renderLineChart([]); }
            });
        }

        function bindFastProducts() {
            $.ajax({
                url: '@Url.Content("~/Home/mypieChart")',
                type: 'POST',
                dataType: 'json',
                success: renderProductChart,
                error: function () { renderProductChart([]); }
            });
        }

        function bindStockMovement() {
            $.ajax({
                url: '@Url.Content("~/Home/GetStockMovement")',
                type: 'GET',
                dataType: 'json',
                success: function (data) {
                    $('#stock-received').text(data.PurchaseItemsQuantity).removeClass('text-muted');
                    $('#stock-sold').text(data.SaleItemsQuantity).removeClass('text-muted');
                    $('#stock-remaining').text(data.WarestockRemaining).removeClass('text-muted');
                },
                error: function () {
                    $('#stock-received, #stock-sold, #stock-remaining').text('—');
                }
            });
        }

        $(function () {
            bindLastRegister(7);
            bindFastProducts();
            bindStockMovement();

            $('#selectLastDays').on('change', function () {
                bindLastRegister($(this).val());
            });
        });
    })();
</script>
