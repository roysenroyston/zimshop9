@model ShopMate.Models.DebitCreditNote

@{
    ViewBag.Title = "Create";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}

<script src="~/Content/ckeditor/ckeditor.js"></script>

@Html.StarkAjaxFormSubmiter("frmProductStock", "tbProductStock", true, "Action Successfully Executed")

@{
    if (!Ajax.IsThisAjaxRequest())
    {
        <section class="content-header">
            <h1>
                @ViewBag.Title
                <small>@ViewBag.Title</small>
            </h1>
        </section>
    }
}
<script type="text/javascript">
    $(function () {
        $('select').searchableOptionList({
            maxHeight: '250px'
        });
    });
</script>
@using (Html.BeginForm("Create", "DebitCreditNote", FormMethod.Post, new { enctype = "multipart/form-data", id = "frmProductStock" }))
{
    @Html.AntiForgeryToken()
    <!-- Main content -->
    <section class="content">
        <!-- Small boxes (Stat box) -->
        <div class="row">
            <div class="col-xs-12">
                <div class="box box-solid box-primary">
                    <div class="box-header">
                        <h3 class="box-title">Fill ProductStock  Form</h3>
                    </div><!-- /.box-header -->
                    <!-- form start -->
                    <div role="form">
                        <div class="box-body">

                            <div class="col-md-12">
                                <div class="col-md-2">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.RecieptId, new { @class = "" })
                                        @Html.DropDownList("ReceiptId", null, "-Select-Receipt Id-", new { @Id = "receiptId" })
                                        @* @Html.StarkDropDownAjaxLink("/User/CreateVendor", "AddMore", "")*@
                                    </div>
                                </div>
                                <div class="col-xs-3">
                                    <div class="form-group">
                                        @Html.LabelFor(model => model.WarehouseId, new { @class = "" })
                                        @Html.DropDownList("WarehouseId", null, "-Select-Warehouse-", new { @Id = "warehouseFrom" })
                                        @* <input type="number" id="warehouseFrom" name="warehouseFrom" placeholder="warehouse" readonly class="form-control" />*@
                                    </div>
                                </div>
                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <strong>Receipt Type</strong>
                                        <select name="ReceiptType" id="receiptType">
                                            <option value="">-Select Receipt Type -</option>
                                            <option value="DebitNote">Debit Note</option>
                                            <option value="CreditNote">Credit Note</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="col-xs-3">
                                    <div class="form-group">
                                        <strong>Receipt Currency</strong>
                                        <select name="ReceiptCurrency" id="receiptCurrency">
                                            <option value="">-Select Receipt Type -</option>
                                            <option value="USD">USD</option>
                                            <option value="ZWG">ZWG</option>
                                        </select>
                                    </div>
                                </div>

                            </div>


                            <div class="col-md-12">
                                <table class="table table-bordered table-hover" id="tab_logic">
                                    <thead>
                                        <tr>
                                            <th style="width:25%">Product</th>
                                            <th style="width:25%">Quantity</th>
                                            <th style="width:25%"> Price</th>
                                            <th style="width:25%"> Vat</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>

                                            <td>
                                                @Html.DropDownList("ProductId", null, "-Select Product", new { @Id = "products" })

                                            </td>
                                            <td>
                                                <input type="number" id="quantity" name="quantity" placeholder="Quantity" class="form-control" />
                                            </td>
                                            <td>
                                                <input type="number" id="unitPrice" name="unitPrice" placeholder="Price" class="form-control" />
                                            </td>
                                            <td>
                                                <input type="number" id="vat" name="vat" placeholder="vat" readonly class="form-control" />
                                            </td>
                                            <td style="display:none">
                                                <input type="text" id="Name" name="name" placeholder="Name" class="form-control" />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div class="col-md-12">
                                    <a id="addToList" class="btn btn-primary">Add To List</a>
                                </div>
                            </div>
                            <div class="col-md-12">
                                <table id="detailsTable" class="table table-bordered table-hover">
                                    <thead>
                                        <tr>


                                            <th style="width:15%">Product Id</th>
                                            <th style="width:30%">Product Name</th>
                                            <th style="width:20%">Quantity</th>
                                            <th style="width:20%">Price</th>
                                            <th style="width:20%">Vat</th>
                                            <th style="width:20%">Total Price</th>

                                            <th style="width:10%"></th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                </table>
                            </div>


                            <div class="col-md-12">

                                <div class="form-group">
                                    <label>Note</label>
                                    <br />
                                    <textarea id="Description" name="Description"></textarea>
                                </div>

                                <div class="form-group" style="width:180px">
                                    <label>Total Invoice Cost</label>
                                    <br />
                                    <input type="number" id="Total" name="Total" placeholder="0.00" value="0.00" class="form-control" />

                                </div>
                                <div class="form-group" style="width:180px">
                                    <label>Total Vat</label>
                                    <br />
                                    <input type="number" id="Totalvat" name="Totalvat" placeholder="0.00" value="0.00" class="form-control" />

                                </div>
                            </div>
                            <div class="form-group">
                                @Html.Hidden("AddedBy", Env.GetUserInfo("userid"))
                            </div>
                            <div class="form-group">
                                @Html.Hidden("DateAdded", DateTime.Now)
                            </div>
                            <div class="form-group">
                                @Html.Hidden("ModifiedBy", Env.GetUserInfo("userid"))
                            </div>
                            <div class="form-group">
                                @Html.Hidden("DateModied", DateTime.Now)
                            </div>





                        </div>
                        <div class="box-footer">
                            @*@Html.StarkInputButtion("Create New", "submit", "btn btn-primary", "")*@
                            <button id="saveOrder" type="submit" class="btn btn-primary">Save Note</button>

                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-primary" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
}


<script type="text/javascript">



    $(document).ready(function () {

        $("#receiptId").on("change", function () {
            var cutsheetname = $(this).children("option:selected").text();
            var selectedrawmaterialsId = $(this).children("option:selected").val();
            var value = $('#dropDownId:selected').val();
            console.log(value);
            $.ajax(
                {
                    url: '/DebitCreditNote/GetQuotationItems?id=' + cutsheetname,
                    type: 'GET',
                    data: "",
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {
                        //  alert("u here!!!!")
                        var mySelect = "";

                        var obj = $.parseJSON(data)
                        console.log(obj);


                        $('#Totalvat').val(obj.ngoni.vat);
                        $('#Total').val(obj.ngoni.subtotal);
                        //  $('#test').val(obj.ngoni.Id);

                        $.each(obj.data, function (index, value) {

                            //var productItem = '<tr><td>' + value.RawMaterialsname + '</td><td>' + value.Quantity + '</td><td>' + value.UnitPrice + `</td><td>${cutsheetname}</td><td hidden>${obj.ngoni.FinishedGoodsQuantity}</td></tr>`;
                            var productItem = '<tr><td>' + value.ProductId + '</td><td>' + value.CustomerName + '</td><td>' + value.Quantity + '</td><td>' + value.SalePrice + '</td><td>' + value.TotalAmountWithTax + '</td><td>' + value.TotalAmount + '</td><td><a data-itemId="0" href="#" class="deleteItem">Remove</a></td></tr>';
                            //  $("#tbInvoiceItem tbody").append(productItem);
                            $("#detailsTable tbody").append(productItem);
                            // detailsTableBody.append(productItem);
                        });
                    },

                    error: function (req, textStatus, errorThrown) {
                        alert("error1");
                    }
                });




        });
    });


    $(document).ready(function () {

        $("#products").on("change", function () {
            //var selectedProductId = $(this).children("option:selected").val();
            var value = $('#dropDownId:selected').val();
            var selectedWarehouse = $("#warehouseFrom").val();
            console.log(value);
            $.ajax(
                {
                    url: '/Product/GetDetail?id=' + $(this).children("option:selected").val() + `&warehouseFrom=${selectedWarehouse}`,
                    type: 'GET',
                    data: "",
                    contentType: 'application/json; charset=utf-8',
                    success: function (data) {

                        $("#Name").val(data.Name);
                        $("#unitPrice").val(data.Sprice.toFixed(2));
                        $("#vat").val(data.taxId);
                        $("#quantity").attr({ "min": 1, "max": 0, placeholder: `Quantity (${data.remainingquantity})` });
                    },
                    error: function () {
                        alert("error");
                    }
                });
        });
    });

    function GrossAmount(amount) {
        var oldAmount = $("#Total").val();

        var total = parseFloat(oldAmount) + parseFloat(amount);

        $("#Total").val(total.toFixed(2));


    }

    function GrossVat(amount) {
        var oldAmount = $("#Totalvat").val();

        var total = parseFloat(oldAmount) + parseFloat(amount);

        $("#Totalvat").val(total.toFixed(2));


    }


    //Add Multiple Materails.
    $("#addToList").click(function (e) {
        e.preventDefault();

        if ($.trim($("#products").val()) == "" || $.trim($("#quantity").val()) == "") return;

        console.log('adding');

        if ($("#vat").val() == 5) {
            tx = 0.00;
        } else if ($("#vat").val() == 6) {
            tx = 0.00;
        }
        else if ($("#vat").val() == 2) {

            var qty = $("#quantity").val();
            var vatx = $("#vattotal").val();
            var rat = $("#unitPrice").val();
            var actRate = (parseFloat(rat) / 1.000);
            tx = (parseFloat(qty) * parseFloat(actRate)) * 0.15;
            totalvat = parseFloat(tx) + parseFloat(vatx);
            //$("#vattotal").val(totalvat.toFixed(2));
            console.log(tx);
        }



        var description = $("#products").val(),
            name = $("#Name").val(),
            quantity = $("#quantity").val(),
            unitPrice = $("#unitPrice").val(),
            vat = tx,
            vattotal = 0,
            subtotal = (parseFloat(unitPrice) * parseInt(quantity))/*+vat*/
        console.log(vat)
        vattotal = vattotal * tx,
            detailsTableBody = $("#detailsTable tbody");

        var productItem = '<tr><td>' + description + '</td><td>' + name + '</td><td>' + quantity + '</td><td>' + unitPrice + '</td><td>' + vat + '</td><td>' + subtotal + '</td><td><a data-itemId="0" href="#" class="deleteItem">Remove</a></td></tr>';
        detailsTableBody.append(productItem);
        GrossAmount(subtotal);
        GrossVat(vat);
        clearItem();
    });

    //After Add A New description In The List, Clear Clean The Form For Add More description.
    function clearItem() {
        $("#description").val('');
        $("#Name").val('');
        $("#unitPrice").val('');
        $("#quantity").val('');
    }


    // After Add A New Order In The List, If You Want, You Can Remove It.
    $(document).on('click', 'a.deleteItem', function (e) {
        e.preventDefault();
        var $self = $(this);

        var totalamountt = $self.parents('tr').find('td:eq(5)').html();
        var totalamount1 = $self.parents('tr').find('td:eq(4)').html();
        GrossAmount(-totalamountt);
        GrossVat(-totalamount1);
        if ($(this).attr('data-itemId') == "0") {
            $(this).parents('tr').css("background-color", "#ff6347").fadeOut(800, function () {
                $(this).remove();
            });
        }
    });

    //Collect Multiple Quotation List For Pass To Controller
    $("#saveOrder").click(function (e) {
        e.preventDefault();
        debugger
        var QuotationItemArr = [];

        QuotationItemArr.length = 0;

        $.each($("#detailsTable tbody tr"), function () {
            QuotationItemArr.push({
                ProductId: $(this).find('td:eq(0)').html(),
                receiptLineName: $(this).find('td:eq(1)').html(),
                receiptLineQuantity: $(this).find('td:eq(2)').html(),
                receiptLinePrice: $(this).find('td:eq(3)').html(),
                lineVat: $(this).find('td:eq(4)').html(),
                receiptLineTotal: $(this).find('td:eq(5)').html()
            });
        });

        var data = JSON.stringify({
            ReceiptId: $("#receiptId").val(),
            WarehouseId: $("#warehouseFrom").val(),
            Description: $("#Description").val(),
            ReceiptType: $("#receiptType").val(),
            Total: $("#Total").val(),
            Totalvat: $("#Totalvat").val(),
            ReceiptCurrency: $("#receiptCurrency").val(),
            productss: QuotationItemArr,

        });

        $.when(saveOrder(data)).then(function (response) {
            console.log(response);
        }).fail(function (err) {
            console.log(err);
        });
    });

    //After Click Save Button Pass All Data View To Controller For Save Database
    function saveOrder(data) {
        return $.ajax({
            contentType: 'application/json; charset=utf-8',
            dataType: 'json',
            type: 'POST',
            url: "/DebitCreditNote/CreateAsync",
            data: data,
            success: function (result) {
                alert(result);
                location.reload();
            },
            error: function (req, textStatus, errorThrown) {
                //this is going to happen when you send something different from a 200 OK HTTP
                alert('Ooops, something happened: ' + textStatus + ' ' + errorThrown);
            }
        });
    }

</script>
