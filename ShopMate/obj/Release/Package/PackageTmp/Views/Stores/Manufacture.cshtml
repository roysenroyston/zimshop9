                            <tr>
                                <th style="width:150px !important;"> Material  </th>
                                <th style="width:100px !important;"> Qty  </th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>

                    <div class="clearfix"></div>
                    <br />

                </div>
                <div class="clearfix"></div>
                <br />
            </section>

        </div>

        <div class="col-xs-8" style="padding-left:0px;padding-right:0px;">

