        width: 150px;
    }
</style>

<script type="text/javascript">
    $(document).ready(function () {
        var oTableRawMaterial = "";
        var ControlerNameStores = "@Url.Content("~/Stores")";
        // debugger;
        oTableRawMaterial = $("#tbRawMaterial").dataTable({
            "bRetrieve": true,
            "bProcessing": true,
            "dom": 'lBfrtip',
            "sAjaxSource": "@Url.Content("~/Stores/GetRawMaterialManufuctre")",
            "pageLength": 50,
            "lengthMenu": [[5, 10, 25, 50, -1], [5, 10, 25, 50, "All"]],
            "aoColumns": [
                 {
                     "mRender": function (oObj, type, row) {

                         var content = '' + row[0] + ' <br/><b>Tax: ' + row[1] + '</b><br/>Remain:<input type="number" value="'+ row[2] +'" style="width:44px;" id="remainq" readonly/>';

                         return content;
                     }

                 },
            {
                "mRender": function (oObj, type, row) {

                    //var buttons = '<div class="text-center"> <input type="number" value="1" style="width:44px;" id="Qty' + row[1] + '"/> <button onclick="addInv(' + row[1] + ',\'' + row[0] + ',\'' + row[2] + ')" type="button" id="btnPlus" class="btn btn-default btn-xs btn-warning" title="Click To Add" > <i class="fa fa-plus"></i></button></div>';
                    var buttons = '<div class="text-center"> <input type="number" value="1" style="width:44px;" id="Qty' + row[1] + '"/> <button onclick="addInv(' + row[1] + ',\'' + row[0] +'\','+row[2]+')" type="button" id="btnPlus" class="btn btn-default btn-xs btn-warning" title="Click To Add" > <i class="fa fa-plus"></i></button></div>';


                    return buttons;
                }

            }
            ]
        }
        );

        $(".dataTables_filter input").on("keypress", function (e) {
            if (e.which == 13) {
                document.getElementById("btnPlus").click();
            }
        });

        $("#tbody").on('click', ".delete", function () {
            var amt = $(this).attr("value");
            $(this).parents('.item-row').remove();
            GrossAmount(-amt);
        });

        $("#btnPayOut").on('click', function () {
            if (confirm("are you sure you want to take materials to manufacturing!") == true) {
                var products = [];
                //var quantity = [];


                $("tr.item-row").each(function () {
                    $this = $(this);

                    products.push({ product: $this.attr("id"), qty: $this.attr("qty")});
                    //console.log(outputquantity)
                    //console.log(outputdescription)
                    //quantity.push($this.attr("qty"));Norlin
                });
                    $.ajax({
                        url: "/Stores/AddToManufucturing",
                        type: "Post",
                        data: { 'products': products,'PurchaseNote': $("#PurchaseNote").val()},
                        dataType: 'json',//json
                        success: function (result) {
                alert(result);
                location.reload();
            },
            error: function (xhr, status, error) {
                var errorMessage = xhr.status + ': ' + xhr.statusText
                alert('Error - ' + errorMessage);
            }
        });
    }





        });

    });

    function addInv(id, name,remaining)
        {
        var qty = document.getElementById("Qty" + id).value;
        if (remaining >= qty) {
            if (parseInt(qty) > 0)
            {

                    //if ($("#tbody").find("#" + id).length > 0) { //if row already have then remove old one
                    //  //  $($("#tbody").find("#" + id).find(".delete")).click();
                    //    qty+=qty;
                    //}commeted the whole if Norlin
                     var div = '<tr class="item-row" id="' + id + '"  qty="' + qty + '" >   <td> <a class="delete" value="' + id + '" href="javascript:;" title="Remove row">X</a>&nbsp; ' + name + '</td><td>' + qty + '</td></tr>';

                    $("#tbody").append(div);


                    $("#divPayout").show();

            }
            else
            {
                alert("Incrise Quantity First");
            }
            }
                else
                {
                    if (remaining <= 0)
                    {
                        alert("Incrise Quantity First");
                    }
                    else
                    {
                        alert("Remaining quantity is " + remaining);
                    }
                }
        }



</script>

