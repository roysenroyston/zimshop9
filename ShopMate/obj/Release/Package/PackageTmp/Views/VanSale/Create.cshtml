    function subTotal() {
        // Get the value of the text boxes
        unitPrice = document.getElementById("unitPrice").value;
        qauntity = document.getElementById("qauntity").value;

        // "Convert" string to integer
        unitPrice = parseInt(unitPrice);
        qauntity = parseInt(qantity);
        // Alternatively, use parseFloat if you want decimals


        console.log(typeof unitPrice); // number
        console.log(typeof qauntity); // number


        var subTotal = unitPrice * qauntity;
        alert(subTotal); // 8
        return false;
    }

    //Add Multiple Materails.
    $("#addToList").click(function (e) {
        e.preventDefault();

        if ($.trim($("#products").val()) == "" || $.trim($("#openingstock").val()) == "") return;

        console.log('adding');
        var productid = $("#products").val(),
            Description = $("#description").val(),
            OpeningStock = $("#openingstock").val(),
            SellingPrice = $("#sellPrice").val(),
            SellingPriceRtgs = $("#sellpriceRtgs").val(),
            unittotal = (parseFloat(SellingPrice) * parseInt(OpeningStock)).toFixed(2),
            unittotalRtgs = (parseFloat(SellingPriceRtgs) * parseInt(OpeningStock)).toFixed(2),
            detailsTableBody = $("#detailsTable tbody");
            //batch = $("#batchId").val();
        var productItem = '<tr><td>' + productid + '</td><td>' + Description + '</td><td>' + OpeningStock + '</td><td>' + SellingPrice + '</td><td>' + SellingPriceRtgs + '</td><td>' + unittotal + '</td><td>' + unittotalRtgs + '</td><td><a data-itemId="0" href="#" class="deleteItem">Remove</a></td></tr>';
        detailsTableBody.append(productItem);
        GrossAmount(unittotal);
        GrossAmountRtgs(unittotalRtgs);
        $("#OpeningStock").val('');
        clearItem();
    });
    //After Add A New description In The List, Clear Clean The Form For Add More description.
    function GrossAmount(unittotal) {
        console.log(unittotal);
        var oldAmount = $("#Total").val() || 0;
        var newtotal = parseFloat(oldAmount) + parseFloat(unittotal);
        console.log("newtotal: " + newtotal);
        $("#Total").val(newtotal.toFixed(2));
      
    }

    function GrossAmountRtgs(unittotal) {
        console.log(unittotal);
        var oldAmount = $("#TotalRtgs").val() || 0;
        var newtotal = parseFloat(oldAmount) + parseFloat(unittotal);
        console.log("newtotal: " + newtotal);
        $("#TotalRtgs").val(newtotal.toFixed(2));

    }

    function GrossAmount1(unittotal) {
        console.log(unittotal);
        var oldAmount = $("#Total").val() || 0;
        var newtotal = parseFloat(oldAmount) - parseFloat(unittotal);
        console.log("newtotal: " + newtotal);
        $("#Total").val(newtotal.toFixed(2));

    }

    function GrossAmount1Rtgs(unittotal) {
        console.log(unittotal);
        var oldAmount = $("#TotalRtgs").val() || 0;
        var newtotal = parseFloat(oldAmount) - parseFloat(unittotal);
        console.log("newtotal: " + newtotal);
        $("#TotalRtgs").val(newtotal.toFixed(2));

    }

    function clearItem() {
        $("#description").val('');
        $("#openingstock").attr({ "min": 1 }).val('');
        $("#OpeningStock").attr({ "min": 1 }).val('');
        $("#sellPrice").val('');
        $("#sellpriceRtgs").val('');
        $("#unittotalRtgs").val('');
        $("#unittotal").val('');
        $("#products").val('');
    }

