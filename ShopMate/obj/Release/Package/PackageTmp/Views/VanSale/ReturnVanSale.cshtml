@model ShopMate.ModelDto.VanSaleDto

@{
    /**/

    ViewBag.Title = "Details";
    if (Ajax.IsThisAjaxRequest())
    {
        Layout = null;
    }
}
<section class="content-header">
    <h1>
        @ViewBag.Title
        <small>Details</small>
    </h1>
</section>
<section class="content">
    <!-- Small boxes (Stat box) -->
    <div class="row">
        <div class="col-xs-12">

            <div class="box box-solid box-primary">
                <div class="box-header">
                    <h3 class="box-title">Detail of Vansale</h3>
                </div><!-- /.box-header -->
                <div class="box-body table-responsive">

                    <div class="widget-sec">
                        <div class="streaming-table">
                            <table class="table table-striped table-bordered" id="MainTable">

                                <tr>
                                    <td>Van Sale Id</td>
                                    <td>@Html.DisplayFor(model => model.Id)</td>
                                </tr>
                                <tr>
                                    <td>Van</td>
                                    <td>@Html.DisplayFor(model => model.Van)</td>
                                </tr>
                                <tr>
                                    <td>Driver</td>
                                    <td>@Html.DisplayFor(model => model.Driver)</td>
                                </tr>
                                <tr>
                                    <td>Stock Value</td>
                                    <td>@Html.DisplayFor(model => model.StockValue)</td>
                                </tr>
                                <tr>
                                    <td>Date Added</td>
                                    <td>@Html.DisplayFor(model => model.DateAdded)</td>
                                </tr>
                                <tr>
                                    <td>Warehouse</td>
                                    <td>@Html.DisplayFor(model => model.Warehouse)</td>
                                </tr>


                            </table>
                            <div class="col-xs-11" style="margin-left:0%;">
                                @*<table class="table table-striped table-bordered">*@
                                    <table id="detailsTable" class="table table-bordered table-hover">
                                        @*<table class="table" style="font-size: 1.8vmin; width: 98%;height: auto;font-weight: 200;margin-right:2%; position: relative;">*@
                                        <thead style="background-color:#e5e2e2;">
                                            <tr>
                                                <th>Id</th>
                                                <th>Product</th>
                                                <th>OpeningStock</th>
                                                <th>ClosingStock</th>
                                                <th>GoodsSold</th>
                                                <th>SellingPrice</th>
                                                <th>Sales</th>
                                                <th>CostPrice</th>
                                                <th>G.P</th>
                                                <th>Profit</th>
                                                <th>StockValue</th>
                                                <th>Truck</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in Model.items)
                                            {
                                            <tr>
                                                <td>@item.Id</td>
                                                <td>@item.Product</td>
                                                <td>@item.OpeningStock</td>
                                                @*@if (ViewBag.Returned != true)
                                                {*@
                                                    <td id="testme@(item.Id)" contenteditable='true'>@item.ClosingStock</td>
                                                @*}*@


                                                <td>@item.GoodsSold</td>
                                                <td>@item.SalePrice</td>
                                                <td>@item.Sales</td>
                                                <td>@item.UnitPrice</td>
                                                <td>@item.GP</td>
                                                <td>@item.OverallGP</td>
                                                <td>@item.StockValue</td>
                                                <td>@item.VanSaleId</td>
                                                @*<td></td>*@
                                            </tr>
                                            }

                                        </tbody>
                                    </table>
</div>
                            <div class="box-footer">
                                @*@if (ViewBag.Returned != true)
                                {*@
                                    <button id="saveOrder" type="submit" class="btn btn-primary">return van sale</button>
                            @*    }*@


                                @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-primary" })
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

