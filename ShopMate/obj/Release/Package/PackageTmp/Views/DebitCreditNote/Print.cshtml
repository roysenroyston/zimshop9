<section class="content" style="background-color: #996600; background-image: url(@Url.Content("~/Content/bg/mining.jpg"));">
    <!-- Small boxes (Stat box)  -->
    <div class="row">


        <div class="col-xs-12 print">
            <div id="print-content" class="content invoice">

                <div class="col-xs-12">
                    <div class="col-xs-6">
                        <div class="form-group">
                            <figure class="pull-left">
                                @* <img id="KediLogo" class="pull-left" img src="~/Content/bg/" style="width:200px; height:100px;margin-top:1%;" />           <br />*@
                                <img src="data:image/png;base64,@Model.baseLogo" style="width: 200px; height: 150px; margin-top: 1%;" alt="Logo" />
                                @*<br />
                        <br />
                        <div id="KediAddress">
                            <kediAddress>
                                <strong>@Model.CompanyName</strong><br>
                                @Html.Raw(Model.CompanyAddress)<br>
                                TIN:@Model.tinNo<br />
                                VAT No: @Model.CustomerVat<br />
                                Email:   @Model.email<br />
                                Mobile: @Model.CompanyContact
                            </kediAddress>

                        </div>*@

                            </figure>

                        </div>
                    </div>
                    <br />

                    <div class="col-xs-3">

                        <div style="  font-size: 15px; width: 100%; text-align:right; ">


                            
                                @{
                                    var code = Model.VerificationCode != null
                                        ? Model.VerificationCode.ToUpper()
                                        : string.Empty;

                                    var formattedCode = string.Join("-",
                                        Enumerable.Range(0, code.Length / 4)
                                                  .Select(i => code.Substring(i * 4, 4)));
                                }
                                    

                                    Verification Code <br /> formattedCode
                                <p>You can verify this receipt manually at</p>


                                @Model.qrUrl<br />
                                @*Fiscal Day No : @Model.fiscalDayNumber<br />*@



                            </div>

                    </div>
                    <div class="col-xs-2">


                        <div style="text-align: left;width:45%; margin-left: 2%; margin-top: 1%; margin-right: 2%; font-size: 11px; width: 30%;">

                            @*<img src='https://chart.googleapis.com/chart?chs=100x100&cht=qr&chl=@Model.qrCode&choe=UTF-8'><br />*@
                            <img src="https://api.qrserver.com/v1/create-qr-code/?data=@Model.qrCode&amp;size=150x150" alt="" title="HELLO" /><br />
                            @*Verification Code : @Model.VerificationCode<br />
                    @Model.qrUrl<br />
                    Fiscal Day No : @Model.fiscalDayNumber<br />
                    <div class="pull-left">
                        Date:@Model.Duedate
                    </div>
                    <br />
                    <br />
                    <div>


                        <span><strong>Bill To:</strong></span>
                        <address style="width:45%;">
                            @Model.customer<br />
                            <strong> Address :</strong>@Model.ToInfo<br />
                            Customer VAT No: @Model.CustomerVat<br />
                        </address>
                    </div>*@

                        </div>
                    </div>














                </div>

                <br />
                <br />

                <span class="Fiscal-Heading" style="text-align:center;margin-left:0%; font-weight: bold;"><h3> <strong>  @Model.ReceiptType </strong></h3></span>

                <br />

                <div class="col-xs-12">


                    <div class="col-xs-6">
                        <strong>SELLER</strong>

                        <div id="KediAddress">
                            <kediAddress>
                                @Model.CompanyName<br>
                                @Html.Raw(Model.CompanyAddress)<br>
                                TIN:@Model.tinNo<br />
                                VAT No: @Model.vat<br />
                                Email:   @Model.email<br />
                                Mobile: @Model.CompanyContact
                            </kediAddress>

                        </div>
                    </div>

                    <div class="col-xs-6">
                        <strong>BUYER</strong>

                        <div id="KediAddress">
                            <kediAddress>
                                @Model.customer<br>
                                @Html.Raw(Model.customerAddress)<br>
                                TIN:@Model.customerTin<br />
                                VAT No: @Model.customerVat<br />
                                Email:   @Model.customerEmail<br />
                                Mobile: @Model.customerPhone
                            </kediAddress>


                        </div>
                    </div>

                </div>
                <div style="clear:both; margin-top:100px">
                    <hr style="border: none; border-top: 2px solid #000 ; margin: 15px 0;" />
                </div>
                <div class="col-xs-12">
                    <div class="col-xs-6">
                        Invoice Number:@Model.Id /500 <br />
                        Customer Reference Number:@Model.customer<br />
                        Device Serial Number:@Model.deviceSerialNo

                    </div>
                    <div class="col-xs-6">
                        Fiscal Day No : @Model.fiscalDayNumber<br />
                        Date:@Model.Duedate<br />
                        Fiscal device Id: @Model.deviceID<br />

                    </div>
                </div>
                <div style="clear:both; margin-top:100px">
                    <hr style="border: none; border-top: 2px solid #000 ; margin: 15px 0;" />
                </div>
                <span class="Fiscal-Heading" style="text-align:center;margin-left:0%; font-weight: bold;"><h3> <strong>  @Model.ReceiptType  </strong></h3></span>
                <div class="col-xs-12">
                    <div class="col-xs-6">
                        Invoice Number:@Model.Id  <br />
                        Customer Reference Number:@Model.customer<br />
                        Device Serial Number:@Model.deviceSerialNo
                    </div>
                    <div class="col-xs-6">
                        Date:@Model.Duedate
                    </div>
                </div>
                <div style="clear:both; margin-top:100px">
                    <hr style="border: none; border-top: 2px solid #000 ; margin: 15px 0;" />
                </div>
                <div class="invoice-body">

                    <div class="Table-Area-Container">
                        <div style="width:100%;">
                            <section>
                                <div class="Table-Area">
                                    <table class="table" style="font-size: 11px; width: 98%;height: auto;font-weight: 200; position: relative;">
                                        <thead style="background-color:#e5e2e2;">
                                            <tr>


                                                <th class="heading-print">PRODUCT NAME</th>
                                                <th class="heading-print">QUANTITY</th>
                                                <th class="heading-print">UNIT PRICE</th>
                                                <th class="heading-print">VAT</th>
                                                <th class="heading-print">SUBTOTAL</th>


                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var items in Model.items)
                                            {
                                                <tr>
                                                    <td> @items.receiptLineName</td>
                                                    <td> @items.receiptLineQuantity</td>
                                                    <td>@items.receiptLinePrice</td>
                                                    <td>@items.vat</td>
                                                    <td>@items.receiptLineTotal</td>

                                                </tr>
                                            }

                                        </tbody>
                                    </table>


                                    <br />
                                    <br />
                                    <br />
                                    <br />
                                    <br />
                                    <br />
                                    <br />
                                    <br />
                                    <br />
                                    <br />
                                    <br />
                                    <br />
                                    @*<br />*@
                                    <div id="footer " style="display: block; width: 98%;  height: 280px; position: relative; page-break-inside: avoid; ">
                                        <div style="float: none; position: static; overflow: visible;  page-break-inside: avoid;">
                                            <div class="pull-right" style="text-align: left; margin-left: 2%; font-weight: bold; margin-right: 0%; margin-top: 1%; page-break-inside: avoid; font-size: 11px; width: 21%;">
                                                Total(Excl):&nbsp; @Model.subtotal
                                                <p>&nbsp;&nbsp;</p>
                                                Tax:&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; @Model.vat
                                                <p>&nbsp;&nbsp;</p>

                                                Total(Incl):&nbsp;&nbsp; @Model.total
                                            </div>
                                            <br />
                                            <br />
                                            <br />
                                            <br />
                                            <br />
                                            <div class="Banking-Details pull-left" style="float: left; font-size: 12px; font-weight: bold; left: 10px; width: 30%; margin-left: 0%; page-break-inside: avoid;"> @Model.Remarks</div>
                                            <br />






                                        </div>

                                    </div>
                            </section>
                        </div>
                    </div>


                </div>
            </div>
                </div>
            </div>


    <div class="no-print">
        <a class="btn btn-app" id="btnPrint" onclick="window.print()">
            <i class="fa fa-print"></i>
            Print This
        </a>
    </div>
</section>

